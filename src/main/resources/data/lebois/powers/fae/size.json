{
  "type": "origins:multiple",
  "resource": {
    "type": "origins:resource",
    "min": 0,
    "max": 2,
    "start_value": 1
  },
  "increment": {
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_resource",
      "change": 1
    }
  },
  "decrement": {
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_resource",
      "change": -1
    },
    "key": {
      "key": "key.origins.secondary_active"
    }
  }
}