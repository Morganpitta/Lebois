{
  "type": "origins:multiple",
  "charge": {
    "type": "origins:resource",
    "min": 0,
    "max": 100,
    "min_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:resource",
        "resource": "*:*_toggle",
        "comparison": "==",
        "compare_to": 1
      },
      "if_action": {
        "type": "origins:change_resource",
        "resource": "*:*_toggle",
        "change": -1
      }
    },
    "hud_render": {
      "should_render": true,
      "bar_index": 0,
      "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
      "condition": {
        "type": "origins:resource",
        "resource": "*:*_charge",
        "comparison": "<",
        "compare_to": 100
      }
    }
  },
  "toggle": {
    "type": "origins:resource",
    "min": 0,
    "max": 1
  },
  "active_self": {
    "type": "origins:active_self",
    "key": {
      "key": "key.origins.secondary_active"
    },
    "entity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:resource",
        "resource": "*:*_toggle",
        "comparison": "==",
        "compare_to": 1
      },
      "if_action": {
        "type": "origins:and",
        "actions": [
          {
            "type": "origins:change_resource",
            "resource": "*:*_toggle",
            "change": -1
          },
          {
            "type": "origins:play_sound",
            "sound": "minecraft:entity.evoker.cast_spell",
            "volume": 0.8,
            "pitch": 1.5
          },
          {
            "type": "origins:spawn_particles",
            "particle": "minecraft:cloud",
            "count": 15,
            "speed": 0.1,
            "spread": {
              "x": 0,
              "y": 0,
              "z": 0
            },
            "offset_y": 0.5
          }
        ]
      },
      "else_action": {
        "type": "origins:if_else",
        "condition": {
          "type": "origins:resource",
          "resource": "*:*_charge",
          "comparison": "==",
          "compare_to": 100
        },
        "if_action": {
          "type": "origins:and",
          "actions": [
            {
              "type": "origins:change_resource",
              "resource": "*:*_toggle",
              "change": 1
            },
            {
              "type": "origins:play_sound",
              "sound": "minecraft:entity.evoker.cast_spell",
              "volume": 0.8,
              "pitch": 1.0
            },
            {
              "type": "origins:spawn_particles",
              "particle": "minecraft:cloud",
              "count": 15,
              "speed": 0.1,
              "spread": {
                "x": 0,
                "y": 0,
                "z": 0
              },
              "offset_y": 0.5
            }
          ]
        }
      }
    }
  },
  "action_over_time": {
    "type": "origins:action_over_time",
